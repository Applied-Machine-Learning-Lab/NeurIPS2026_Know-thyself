+    logits = outputs.get("logits")
+    if logits is None:
+        return outputs.get("loss", torch.tensor(0.0))
+
+    logits = logits.float()
+
+    shift_logits = logits[..., :-1, :].contiguous()
+    shift_labels = labels[..., 1:].contiguous()
+    shift_ref_logits = ref_logits[..., :-1, :].contiguous().float()
+
+    batch_size, seq_len, vocab_size = shift_logits.shape
+    device = shift_logits.device
+
+    total_transfer = torch.tensor(0.0, device=device)
+    total_anchor = torch.tensor(0.0, device=device)
+    total_other = torch.tensor(0.0, device=device)
+    n_answer_tokens = 0
+    n_samples_with_answers = 0
+
+    for b in range(batch_size):
+        answer_mask = shift_labels[b] != ignore_index
+        answer_positions = answer_mask.nonzero(as_tuple=True)[0]
+
+        if len(answer_positions) == 0:
+            continue
+
+        n_samples_with_answers += 1
+
+        transfer_losses = []
+        dynamic_B_ids = []
+        for pos in answer_positions:
+            correct_id = shift_labels[b, pos].item()
+            cur_logits = shift_logits[b, pos]
+
+            with torch.no_grad():
+                temp = cur_logits.detach().clone()
+                temp[correct_id] = -float('inf')
+                b_id = temp.argmax().item()
+            dynamic_B_ids.append(b_id)
+
+            z_A = cur_logits[correct_id]
+            z_B = cur_logits[b_id]
+            transfer_losses.append(F.softplus(z_B - z_A))
+
+        l_transfer = torch.stack(transfer_losses).mean()
+        total_transfer = total_transfer + l_transfer
+        n_answer_tokens += len(answer_positions)
+
+        anchor_losses = []
+        for idx, pos in enumerate(answer_positions):
+            correct_id = shift_labels[b, pos].item()
+            b_id = dynamic_B_ids[idx]
+
+            cur_logits_pos = shift_logits[b, pos]
+            ref_logits_pos = shift_ref_logits[b, pos]
+
+            mask = torch.ones(vocab_size, dtype=torch.bool, device=device)
+            mask[correct_id] = False
+            mask[b_id] = False
+
+            log_p_new = F.log_softmax(cur_logits_pos[mask], dim=-1)
+            p_old = F.softmax(ref_logits_pos[mask], dim=-1)
+            anchor_losses.append(F.kl_div(log_p_new, p_old, reduction='sum'))
+
+        l_anchor = torch.stack(anchor_losses).mean()
+        total_anchor = total_anchor + l_anchor
+
+        non_answer_mask = ~answer_mask
+        non_answer_positions = non_answer_mask.nonzero(as_tuple=True)[0]
+
+        if len(non_answer_positions) > 0:
+            log_p_new = F.log_softmax(shift_logits[b, non_answer_positions], dim=-1)
+            p_old = F.softmax(shift_ref_logits[b, non_answer_positions], dim=-1)
+            l_other = F.kl_div(log_p_new, p_old, reduction='batchmean')
+        else:
+            l_other = torch.tensor(0.0, device=device)
+
+        total_other = total_other + l_other
+
+    if n_samples_with_answers == 0:
+        return torch.tensor(0.0, device=device, requires_grad=True)
+
+    loss = (total_transfer + lambda_anchor * total_anchor + lambda_other * total_other) / n_samples_with_answers
+
+    if replay_input_ids is not None and replay_ref_logits is not None and model is not None and len(replay_input_ids) > 0:
+        replay_kl_losses = []
+        for r_ids, r_ref_logits in zip(replay_input_ids, replay_ref_logits):
+            r_input = r_ids.unsqueeze(0).to(device)
+            r_logits = model(r_input).logits[0].float()
+            log_p_new = F.log_softmax(r_logits, dim=-1)
+            p_old = F.softmax(r_ref_logits.to(device).float(), dim=-1)
+            kl = F.kl_div(log_p_new, p_old, reduction='batchmean')
+            replay_kl_losses.append(kl)
+        l_replay = torch.stack(replay_kl_losses).mean()
+        loss = loss + lambda_replay * l_replay
