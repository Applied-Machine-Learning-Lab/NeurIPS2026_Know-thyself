diff --git a/verl/workers/actor/dp_actor.py b/verl/workers/actor/dp_actor.py
index e5fb886..ba7881d 100644
--- a/verl/workers/actor/dp_actor.py
+++ b/verl/workers/actor/dp_actor.py
@@ -39,7 +39,29 @@ from .config import ActorConfig
 try:
     from flash_attn.bert_padding import index_first_axis, pad_input, rearrange, unpad_input
 except ImportError:
-    pass
+    def unpad_input(hidden_states, attention_mask):
+        seqlens = attention_mask.sum(dim=-1, dtype=torch.int32)
+        indices = torch.nonzero(attention_mask.flatten(), as_tuple=False).flatten()
+        cu_seqlens = torch.cat([seqlens.new_zeros(1), seqlens.cumsum(0)], dim=0).to(torch.int32)
+        max_seqlen = int(seqlens.max().item())
+        hidden_states = hidden_states.view(-1, *hidden_states.shape[2:])[indices]
+        return hidden_states, indices, cu_seqlens, max_seqlen
+
+    def pad_input(hidden_states, indices, batch, seqlen):
+        output = hidden_states.new_zeros(batch * seqlen, *hidden_states.shape[1:])
+        output[indices] = hidden_states
+        return output.view(batch, seqlen, *hidden_states.shape[1:])
+
+    def index_first_axis(x, indices):
+        return x.view(-1, *x.shape[2:])[indices]
+
+    def rearrange(x, pattern, **kwargs):
+        if pattern.strip().startswith("b s"):
+            return x.view(-1, *x.shape[2:])
+        elif pattern.strip().startswith("(b s)"):
+            b = kwargs.get("b", x.shape[0])
+            return x.view(b, -1, *x.shape[1:])
+        return x
 
 
